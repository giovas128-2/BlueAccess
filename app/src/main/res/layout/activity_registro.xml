<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Crear cuenta"
            android:textColor="@color/primary_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Únete a BlueAccess"
            android:textColor="@color/secondary_text"
            android:textSize="16sp" />

        <!-- NOMBRE COMPLETO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNombreRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Nombre completo"
            app:boxStrokeColor="@color/field_stroke"
            app:hintTextColor="@color/field_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:maxLines="1"
                android:textColor="@color/field_text"
                android:textColorHint="@color/field_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCorreoRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Correo electrónico"
            app:boxStrokeColor="@color/field_stroke"
            app:hintTextColor="@color/field_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreoRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:maxLines="1"
                android:textColor="@color/field_text"
                android:textColorHint="@color/field_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONTRASEÑA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPasswordRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Contraseña"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/field_stroke"
            app:hintTextColor="@color/field_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:maxLines="1"
                android:textColor="@color/field_text"
                android:textColorHint="@color/field_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRMAR CONTRASEÑA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirmarRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Confirmar contraseña"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/field_stroke"
            app:hintTextColor="@color/field_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:maxLines="1"
                android:textColor="@color/field_text"
                android:textColorHint="@color/field_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN CREAR CUENTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="CREAR CUENTA"
            android:textColor="@color/on_primary_action"
            app:backgroundTint="@color/primary_action"
            app:cornerRadius="16dp" />

        <!-- BOTÓN REGRESAR AL LOGIN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Ya tengo una cuenta"
            android:textColor="@color/primary_action" />

    </LinearLayout>

</ScrollView>
