<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@color/header_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="Logo de BlueAccess"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BlueAccess"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tu acceso, más seguro y sencillo"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- TARJETA DEL LOGIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@color/card_background"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido de nuevo"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ingresa tus datos para continuar"
                android:textColor="@color/secondary_text"
                android:textSize="14sp" />

            <!-- CORREO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCorreo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="Correo electrónico"
                app:boxStrokeColor="@color/field_stroke"
                app:hintTextColor="@color/field_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:maxLines="1"
                    android:textColor="@color/field_text"
                    android:textColorHint="@color/field_hint" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Contraseña"
                app:endIconMode="password_toggle"
                app:boxStrokeColor="@color/field_stroke"
                app:hintTextColor="@color/field_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:maxLines="1"
                    android:textColor="@color/field_text"
                    android:textColorHint="@color/field_hint" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- RECUPERAR CONTRASEÑA -->
            <TextView
                android:id="@+id/tvRecuperar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="end|center_vertical"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/primary_action"
                android:textSize="13sp" />

            <!-- INICIAR SESIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="INICIAR SESIÓN"
                android:textColor="@color/on_primary_action"
                app:backgroundTint="@color/primary_action"
                app:cornerRadius="16dp" />

            <!-- REGISTRO -->
            <TextView
                android:id="@+id/tvRegistro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="¿No tienes una cuenta? Regístrate"
                android:textColor="@color/primary_action"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
